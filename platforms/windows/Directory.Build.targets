<Project>
  <ItemGroup Condition="'$(SharedCoreDirectory)' != ''">
    <None Include="$(SharedCoreDirectory)/*.dll;$(SharedCoreDirectory)/*.dylib;$(SharedCoreDirectory)/*.so;$(SharedCoreDirectory)/*LICENSE.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
  </ItemGroup>
</Project>
